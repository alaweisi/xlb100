NODE_ENV=staging
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3000

# Copy this template to .env.staging.local and populate every required secret.
# The checked-in template is intentionally non-runnable.

# Demo-only background processors. Keep disabled unless staging is explicitly used for a controlled demo.
AUTO_RUN_ENABLED=false
AUTO_RUN_INTERVAL_MS=8000
AUTO_RUN_CITY_CODES=hangzhou

MYSQL_HOST=mysql
MYSQL_PORT=3306
STAGING_MYSQL_PORT=3307
MYSQL_DATABASE=xlb_staging
MYSQL_USER=xlb
# Required. Generate independent strong values; never deploy this example as-is.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
STAGING_REDIS_PORT=6380
REDIS_PASSWORD=
JWT_SECRET=
JWT_ACTIVE_KID=primary
JWT_KEYS_JSON=
JWT_ISSUER=xlb-backend
JWT_AUDIENCE=xlb-apps
JWT_TTL_SECONDS=86400
AUTH_PHONE_HASH_SECRET=
AUTH_OTP_PEPPER=

AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_LOCK_SECONDS=900
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_DEBUG_CODE_ENABLED=false
STAGING_DEMO_CUSTOMER_AUTH_ENABLED=false
# Public demo identifier; set at runtime to the shared packages/types manifest value.
# It remains blank here so this example stays fail-closed and non-runnable.
STAGING_DEMO_CUSTOMER_PHONE=
# Investor Demo authentication is disabled unless explicitly enabled. Identity
# values are public demo identifiers, but remain blank here so this template is
# non-runnable and cannot accidentally enable the flow.
STAGING_INVESTOR_DEMO_AUTH_ENABLED=false
STAGING_DEMO_WORKER_ID=
STAGING_DEMO_WORKER_PHONE=
STAGING_DEMO_ADMIN_USER_ID=
STAGING_DEMO_ADMIN_USERNAME=
STAGING_DEMO_CITY_CODE=hangzhou
STAGING_DEMO_TOKEN_TTL_SECONDS=900

# Reset runs as the opt-in Compose profile "demo-reset". Dry-run is the safe
# default. Apply requires explicit runtime values, including the confirmation
# phrase and exact Compose database host/name; do not commit a populated file.
STAGING_DEMO_RESET_MODE=--dry-run
STAGING_DEMO_RESET_ENABLED=false
STAGING_DEMO_RESET_CONFIRMATION=
STAGING_DEMO_RESET_EXPECTED_HOST=
STAGING_DEMO_RESET_EXPECTED_DATABASE=
PAYMENT_MOCK_WEBHOOK_ENABLED=false
